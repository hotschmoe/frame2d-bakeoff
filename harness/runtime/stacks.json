{
  "_comment": "Per-stack facts the runtime harness needs and stack.sh does not expose (SPEC 5.6 only defines build/run functions). Derived from each stack's layout, stack.sh and LOC_EXCLUDE as of run1. stack_sh_sha256 values are not stored here; meta.json records the current hash so drift is visible. loc_buckets: first matching regex (against the stack-relative posix path) wins. 'cli' rolls up into 'engine' in totals (the CLI is a thin front end of the engine) and is also reported alone. Tests are bucketed by file path only: inline Rust/Zig test modules cannot be separated by scc and stay in their source bucket.",
  "common": {
    "loc_ignore_languages": [
      "Markdown",
      "JSON",
      "YAML",
      "TOML",
      "Plain Text",
      "License",
      "gitignore",
      "Properties",
      "Systemd",
      "SVG",
      "Dockerfile",
      "Document",
      "Lockfile"
    ],
    "loc_hard_excludes": [
      "^target/",
      "^build/",
      "^\\.zig-cache/",
      "^\\.zig-global/",
      "^zig-pkg/",
      "^zig-out/",
      "^app/build/",
      "^app/\\.dart_tool/",
      "^\\.tools/",
      "^node_modules/",
      "^vendor/",
      "^app/ios/",
      "^app/android/",
      "^app/macos/",
      "^app/linux/",
      "^\\.git/"
    ],
    "generated_regex": "(^|/)generated/|frb_generated|app/web/engine/|app/ffigen/|\\.g\\.dart$|\\.freezed\\.dart$|pubspec\\.lock$|Cargo\\.lock$|go\\.sum$"
  },
  "stacks": {
    "rust": {
      "family": "rust",
      "port_offset": 0,
      "ui": "egui/eframe (glow)",
      "server_lang": "rust",
      "loc_buckets": [
        [
          "ui",
          "^src/app/"
        ],
        [
          "ui",
          "^src/bin/frame2d-app\\.rs$"
        ],
        [
          "server",
          "^src/bin/frame2d-server\\.rs$"
        ],
        [
          "cli",
          "^src/bin/frame2d\\.rs$"
        ],
        [
          "cli",
          "^src/alloc_count\\.rs$"
        ],
        [
          "glue",
          "^web/"
        ],
        [
          "glue",
          "^Cargo\\.toml$"
        ],
        [
          "glue",
          "^build\\.rs$"
        ],
        [
          "engine",
          "^src/"
        ]
      ],
      "desktop_bundle": "file",
      "engine_lib_globs": [],
      "engine_lib_note": "engine is linked statically into the app; the CLI binary (engine only, no UI or server deps) is the engine-alone proxy",
      "web_engine_globs": [
        "frame2d_bg.wasm"
      ],
      "web_engine_note": "the whole eframe app is the wasm module (engine not separable)",
      "flags": {
        "cli": "cargo build --release --bin frame2d",
        "server": "cargo build --release --bin frame2d-server --features server",
        "desktop": "cargo build --release --bin frame2d-app --features ui",
        "web": "cargo build --release --target wasm32-unknown-unknown --features ui; wasm-bindgen --target web; wasm-opt -O3 (if available)",
        "profile": "opt-level=3, lto=thin, codegen-units=1, strip=true (Cargo.toml)"
      },
      "stripped": {
        "cli": true,
        "server": true,
        "desktop": true,
        "web": "wasm-opt only; name section state not verified"
      },
      "gctrace": {
        "cli": false,
        "app": false
      },
      "xcompile": {
        "kind": "cargo",
        "args": [
          "--bin",
          "frame2d",
          "--bin",
          "frame2d-server",
          "--features",
          "server"
        ],
        "bins": [
          "frame2d",
          "frame2d-server"
        ]
      },
      "deps_loc": "cargo"
    },
    "go": {
      "family": "go",
      "port_offset": 1,
      "ui": "Gio",
      "server_lang": "go",
      "loc_buckets": [
