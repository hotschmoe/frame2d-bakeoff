        "server": "go build -trimpath -ldflags '-s -w' ./cmd/server (CGO_ENABLED=0)",
        "desktop": "go build -trimpath -ldflags '-s -w' ./cmd/app (CGO_ENABLED=0 on windows)",
        "web": "GOOS=js GOARCH=wasm go build -trimpath -ldflags '-s -w' ./cmd/app"
      },
      "stripped": {
        "cli": true,
        "server": true,
        "desktop": true,
        "web": true
      },
      "gctrace": {
        "cli": true,
