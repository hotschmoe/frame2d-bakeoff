        "main.dart.mjs"
      ],
      "web_alt": {
        "label": "wasm",
        "mode": "stdout_prefix",
        "prefix": "wasm:"
      },
      "flags": {
        "cli": "cargo build --release -p frame2d-cli",
        "server": "cargo build --release -p frame2d-server",
        "desktop": "cargo build --release -p frame2d-bridge --target x86_64-pc-windows-msvc (host target on Linux) + flutter build <os> --release",
        "web": "RUSTFLAGS='-C target-feature=+simd128' cargo build --release -p frame2d-bridge --target wasm32-unknown-unknown; wasm-bindgen --target web; wasm-opt -O3 --enable-simd; flutter build web --release [--wasm]",
        "profile": "opt-level=3, lto=true, codegen-units=1, strip=true (workspace Cargo.toml)"
      },
