        "app": false
      },
      "xcompile": {
        "kind": "zig",
        "steps": [
          "cli",
          "server"
        ],
        "extra": [],
        "bins": [
          "frame2d",
          "frame2d-server"
        ]
      },
      "deps_loc": "zig"
