        "server": "zig build server -Doptimize=ReleaseFast",
        "desktop": "zig build desktop -Doptimize=ReleaseFast",
        "web": "zig build web -Doptimize=ReleaseFast (wasm32-freestanding)"
      },
      "stripped": {
        "cli": true,
        "server": true,
        "desktop": true,
        "web": true
